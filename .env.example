# Copy to .env.local for local development. Add the same keys to Vercel.
# Never put these credentials in browser JavaScript or commit .env.local.

# YouTube Data API v3 key; channel resolved from @creyn1um.
YOUTUBE_API_KEY=

# Instagram API with Instagram Login: professional account @creyn1um.
# Token needs instagram_business_basic and instagram_business_manage_insights.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v23.0

# X API v2 bearer token with read access; resolves @wo0tz0.
X_BEARER_TOKEN=
